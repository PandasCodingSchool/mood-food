# Copy to apps/api/.env — every value below has a working local default
# (see src/config/env.ts), so an empty .env is fine with `docker compose up -d`.

PORT=3001
NODE_ENV=development
LOG_LEVEL=info
# Set true behind a load balancer / proxy so req.ip is the client, not the proxy.
TRUST_PROXY=false
# Comma-separated list, or * for any origin.
CORS_ORIGINS=*

# ── Data stores (docker-compose.yml at the repo root) ──
DATABASE_URL=postgres://moodfood:moodfood@localhost:5432/moodfood
DATABASE_SSL=false
DATABASE_POOL_MAX=10
# Apply pending drizzle/ migrations at startup. Turn off if a release job runs `pnpm db:migrate`.
DB_MIGRATE_ON_BOOT=true
REDIS_URL=redis://localhost:6379

# ── Auth ──
SESSION_TTL_DAYS=30
DEFAULT_PHONE_REGION=IN
# console = OTPs are printed in the API log (dev). twilio = real SMS.
SMS_PROVIDER=console
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
# HTTP Basic credentials for /admin (required to change in production).
ADMIN_USERNAME=admin
ADMIN_PASSWORD=changeme

# ── Email (verification + password reset codes) ──
# console = codes are printed in the API log (dev). resend = real email via https://resend.com.
EMAIL_PROVIDER=console
RESEND_API_KEY=
# Must be on a domain verified in Resend.
EMAIL_FROM=MoodFood <hello@moodfood.fun>

# ── Rate limits (requests per 15 minutes) ──
# Per signed-in device, or per IP when anonymous:
RATE_LIMIT_GENERAL=300
# Hard ceiling per IP:
RATE_LIMIT_IP=2000
# /ai-recommendations and /recipe:
RATE_LIMIT_AI=10
# /signals and /predictions:
RATE_LIMIT_SIGNALS=120
# /auth/signup per IP (email sign-up has no OTP gate):
RATE_LIMIT_SIGNUP=20

# ── Intelligence service (apps/intelligence) ──
AI_SERVICE_URL=http://localhost:8000
AI_SERVICE_KEY=
# Shared secret for the signals replay feed; must equal SYNC_KEY in apps/intelligence/.env.
INTELLIGENCE_SYNC_KEY=
AI_TIMEOUT_MS=90000
AI_MAX_RETRIES=0
SWIGGY_TIMEOUT_MS=25000
RECIPE_TIMEOUT_MS=30000
GAME_ASSIST_TIMEOUT_MS=3000
LEARN_TIMEOUT_MS=8000

# ── Swiggy account linking ──
# 32-byte key, base64: `openssl rand -base64 32` (required in production).
SWIGGY_TOKEN_ENCRYPTION_KEY=
SWIGGY_OAUTH_REDIRECT_URI=https://moodfood.fun/api/swiggy/oauth/callback
FRONTEND_ORIGIN=https://moodfood.fun

# ── Push + storage ──
EXPO_ACCESS_TOKEN=
WALL_PHOTO_BUCKET=
