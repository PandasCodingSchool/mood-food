{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "intelligence-lab",
      "runtimeExecutable": "bash",
      "runtimeArgs": ["scripts/lab.sh"],
      "cwd": "apps/intelligence",
      "port": 8510
    },
    {
      "name": "mobile-web",
      "runtimeExecutable": "npx",
      "runtimeArgs": ["expo", "start", "--web", "--port", "8090"],
      "cwd": "apps/mobile",
      "port": 8090,
      "autoPort": true
    },
    {
      "name": "site",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["dev"],
      "cwd": "apps/site",
      "port": 3002
    }
  ]
}
