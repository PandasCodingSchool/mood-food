{
  "name": "moodfood",
  "version": "2.0.0",
  "private": true,
  "description": "Mood-based food recommendation platform",
  "scripts": {
    "dev": "turbo run dev --filter=@moodfood/backend --filter=@moodfood/frontend",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "mobile": "pnpm --filter @moodfood/mobile start",
    "mobile:android": "pnpm --filter @moodfood/mobile exec expo start --android",
    "mobile:ios": "pnpm --filter @moodfood/mobile exec expo start --ios",
    "intelligence": "pnpm --filter @moodfood/intelligence dev"
  },
  "devDependencies": {
    "turbo": "^2.5.0"
  },
  "packageManager": "pnpm@10.34.6",
  "engines": {
    "node": ">=22"
  }
}
